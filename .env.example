# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (used by docker-compose)
POSTGRES_DB=aivanta
POSTGRES_USER=aivanta
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Backend (FastAPI). AIVANTA_DATABASE_URL is set by docker-compose; set it yourself when running locally:
# AIVANTA_DATABASE_URL=postgresql+psycopg://aivanta:change-me-postgres@localhost:5432/aivanta
AIVANTA_JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
AIVANTA_JWT_EXPIRY_MINUTES=480
AIVANTA_CORS_ORIGINS=http://localhost:3000
# Password for the seeded demo accounts (admin@, finance@, analyst@, viewer@aivanta.demo)
AIVANTA_DEMO_PASSWORD=aivanta-demo
# Load the synthetic demonstration dataset on startup (true/false)
AIVANTA_SEED_DEMO=true
AIVANTA_ENVIRONMENT=development

# Frontend (Next.js) — URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000
